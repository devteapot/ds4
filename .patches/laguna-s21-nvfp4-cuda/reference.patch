+                up + b, xq_row + b * 64u, xscale_row + b * 2u);
+        }
+    }
+    gate_value = laguna_subwarp_sum_f32<LANES>(gate_value);
+    up_value = laguna_subwarp_sum_f32<LANES>(up_value);
