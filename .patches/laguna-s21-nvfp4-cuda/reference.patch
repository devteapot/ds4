+static const char *native_json_find_member(const char *text,
+                                           const char *member) {
+    char needle[96];
+    if (snprintf(needle, sizeof(needle), "\"%s\"", member) >=
+        (int)sizeof(needle)) {
+        return NULL;
+    }
+    const char *p = strstr(text, needle);
+    if (!p) return NULL;
+    p += strlen(needle);
+    while (*p && isspace((unsigned char)*p)) p++;
+    if (*p++ != ':') return NULL;
+    while (*p && isspace((unsigned char)*p)) p++;
+    return p;
+}
